# ============================================================
# LabLoop – Root Environment Configuration Reference
# ============================================================
#
# Backend Configuration (backend/.env)
# ------------------------------------------------------------
FLASK_ENV=production
SECRET_KEY=generate_with_python_secrets_token_hex_32
JWT_SECRET_KEY=generate_with_python_secrets_token_hex_32

# Production Database (PostgreSQL)
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://postgres:password@localhost:5432/labloop_db

# File Uploads
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=16777216

# Allowed Frontend URL(s) for CORS & institutional email links (comma-separated if multiple)
FRONTEND_URL=https://labloop.yourdomain.com

# SMTP Email Delivery (Gmail / SendGrid / AWS SES)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your-institutional-sender@domain.edu
MAIL_PASSWORD=your-app-specific-password
MAIL_DEFAULT_SENDER=LabLoop Notification <noreply@labloop.app>

# ------------------------------------------------------------
# Frontend Configuration (frontend/.env)
# ------------------------------------------------------------
VITE_API_BASE_URL=/api
VITE_APP_NAME=LabLoop
VITE_QR_CHECKIN_GRACE_MINUTES=15

