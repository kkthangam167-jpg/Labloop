# ──────────────────────────────────────────────────────────────
# LabLoop – Environment Variable Reference
# Copy this file to .env and fill in the values before running.
# Never commit the actual .env file to source control.
# ──────────────────────────────────────────────────────────────

# Flask runtime environment: development | production | testing
FLASK_ENV=development

# A long, random string used to sign Flask sessions.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# A separate long, random string used to sign JWT tokens.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# PostgreSQL connection string.
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/labloop_db

# Directory (relative to backend root) where user-uploaded files are stored.
UPLOAD_FOLDER=uploads

# Maximum allowed file-upload size in bytes (default: 16 MB = 16777216).
MAX_CONTENT_LENGTH=16777216

# Base URL of the frontend app — used in e-mail links.
FRONTEND_URL=http://localhost:5173

# ── Mail settings (uses Flask-Mail / SMTP) ───────────────────
# SMTP host (e.g. smtp.gmail.com, smtp.sendgrid.net)
MAIL_SERVER=smtp.gmail.com

# SMTP port (587 for STARTTLS, 465 for SSL)
MAIL_PORT=587

# Enable STARTTLS (true | false)
MAIL_USE_TLS=true

# SMTP account username / email address
MAIL_USERNAME=

# SMTP account password or app-specific password
MAIL_PASSWORD=

# "From" address shown in outgoing e-mails
MAIL_DEFAULT_SENDER=LabLoop <noreply@labloop.app>
