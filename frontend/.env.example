# ──────────────────────────────────────────────────────────────
# LabLoop – Frontend Environment Configuration
# Copy this file to .env before building or running.
# Never commit the actual .env file to source control.
# ──────────────────────────────────────────────────────────────

# Base URL for backend API requests
# In local development: /api (proxied by Vite to http://127.0.0.1:5000)
# In production: /api (if behind Nginx/reverse proxy) or https://api.yourdomain.com/api
VITE_API_BASE_URL=/api

# Application Display Name
VITE_APP_NAME=LabLoop

# QR Check-in grace period window in minutes
VITE_QR_CHECKIN_GRACE_MINUTES=15

